# Mit "npm run generate-vapid-keys" erzeugen und hier eintragen.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Kontaktadresse, die Push-Dienste bei Problemen benachrichtigen (Pflichtfeld für web-push)
VAPID_KONTAKT_EMAIL=du@beispiel.de

# Port, auf dem das Backend läuft
PORT=3001

# Uhrzeit für den täglichen Check, Cron-Syntax (Standard: 9:00 Uhr)
CRON_ZEITPLAN=0 9 * * *
